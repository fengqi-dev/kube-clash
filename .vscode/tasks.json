{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: install",
      "type": "npm",
      "script": "install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build: helper",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "command": "./build/bundle-helper.sh",
      "args": ["dev", "build/bin"],
      "windows": {
        "command": "go",
        "args": [
          "build",
          "-trimpath",
          "-ldflags",
          "-s -w -X main.version=dev",
          "-o",
          "build/bin/kubeloop-helper.exe",
          "./cmd/kubeloop-helper"
        ]
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "build",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CGO_ENABLED": "1"
        }
      },
      "osx": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "CGO_ENABLED": "1",
            "CGO_LDFLAGS": "-framework UniformTypeIdentifiers"
          }
        }
      },
      "command": "go",
      "args": [
        "build",
        "-tags",
        "dev",
        "-gcflags",
        "all=-N -l",
        "-o",
        "build/bin/KubeLoop"
      ],
      "windows": {
        "args": [
          "build",
          "-tags",
          "dev",
          "-gcflags",
          "all=-N -l",
          "-o",
          "build/bin/KubeLoop.exe"
        ]
      },
      "dependsOn": ["npm: build", "build: helper"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    }
  ]
}
